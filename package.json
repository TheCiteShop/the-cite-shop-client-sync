{
  "name": "the-cite-shop-client-sync",
  "type": "module",
  "version": "0.0.1",
  "description": "A Zotero plugin for managing and installing custom citation styles from The Cite Shop.",
  "config": {
    "addonName": "The Cite Shop Client Sync",
    "addonID": "theciteshop-sync@theciteshop.com",
    "addonRef": "theciteshop-sync",
    "addonInstance": "TheCiteShopSync",
    "prefsPrefix": "extensions.zotero.theciteshop-sync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheCiteShop/the-cite-shop-client-sync.git"
  },
  "author": {
    "name": "The Cite Shop",
    "email": "info@theciteshop.com",
    "url": "https://theciteshop.com/"
  },
  "bugs": {
    "url": "https://github.com/TheCiteShop/the-cite-shop-client-sync/issues"
  },
  "homepage": "https://theciteshop.com/",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "core-js": "^3.48.0",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.5",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^10.8.1",
    "mocha": "^11.3.0",
    "prettier": "^3.7.4",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.0-beta.4"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "keywords": [
    "zotero",
    "citation",
    "styles",
    "license",
    "plugin"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
